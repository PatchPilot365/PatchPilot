{
  "name": "@patchpilot/api",
  "version": "1.0.15",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:resilient": "node ../../scripts/run-resilient.mjs pnpm exec tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@azure/msal-node": "^6.0.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/session": "^11.1.5",
    "@patchpilot/ai": "workspace:*",
    "@patchpilot/db": "workspace:*",
    "@patchpilot/graph": "workspace:*",
    "@patchpilot/shared": "workspace:*",
    "bullmq": "^5.34.5",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "fflate": "^0.8.2",
    "ioredis": "^5.4.2",
    "nodemailer": "^10.2.0",
    "pino": "^9.5.0",
    "tsx": "^4.23.15",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "postgres": "^3.4.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  }
}
