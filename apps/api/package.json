{
  "name": "@patchpilot/api",
  "version": "0.18.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:resilient": "node ../../scripts/run-resilient.mjs pnpm exec tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@azure/msal-node": "^6.0.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/session": "^11.1.2",
    "@patchpilot/ai": "workspace:*",
    "@patchpilot/db": "workspace:*",
    "@patchpilot/graph": "workspace:*",
    "@patchpilot/shared": "workspace:*",
    "bullmq": "^5.34.5",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.4",
    "fflate": "^0.8.2",
    "ioredis": "^5.4.2",
    "nodemailer": "^10.0.9",
    "pino": "^9.5.0",
    "tsx": "^4.23.13",
    "undici": "^7.29.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "postgres": "^3.4.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
