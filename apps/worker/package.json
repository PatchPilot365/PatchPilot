{
  "name": "@patchpilot/worker",
  "version": "0.18.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:resilient": "node ../../scripts/run-resilient.mjs pnpm exec tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@patchpilot/ai": "workspace:*",
    "@patchpilot/db": "workspace:*",
    "@patchpilot/graph": "workspace:*",
    "@patchpilot/shared": "workspace:*",
    "bullmq": "^6.3.4",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.13",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
