{
  "name": "@patchpilot/worker",
  "version": "1.0.15",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:resilient": "node ../../scripts/run-resilient.mjs pnpm exec tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@patchpilot/ai": "workspace:*",
    "@patchpilot/db": "workspace:*",
    "@patchpilot/graph": "workspace:*",
    "@patchpilot/shared": "workspace:*",
    "bullmq": "^5.34.5",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^5.4.2",
    "pino": "^9.5.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  }
}
