{
  "name": "patchpilot",
  "version": "1.0.15",
  "private": true,
  "description": "Self-hosted, multi-tenant MSP patch management console (Defender/MDVM -> Winget/WUA remediation).",
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "infra:dev:up": "docker compose -f infra/docker-compose.dev.yml up -d",
    "infra:dev:down": "docker compose -f infra/docker-compose.dev.yml down",
    "infra:dev:sample": "sh infra/updater/dev-sample.sh",
    "infra:up": "docker compose -f infra/docker-compose.yml --env-file .env up -d --build",
    "infra:down": "docker compose -f infra/docker-compose.yml --env-file .env down",
    "db:generate": "pnpm --filter @patchpilot/db generate",
    "db:migrate": "pnpm --filter @patchpilot/db migrate",
    "db:seed": "pnpm --filter @patchpilot/db seed",
    "version:bump": "node scripts/bump-version.mjs",
    "release": "node scripts/release.mjs",
    "test:scripts": "node --test scripts/release.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "turbo": "^2.11.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.0"
  },
  "pnpm": {
    "overrides": {
      "ioredis": "5.10.1",
      "vite": "^6.0.5",
      "find-my-way": "^9.9.0",
      "fast-uri": "^3.1.8"
    }
  }
}
